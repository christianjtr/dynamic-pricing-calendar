{
	"name": "dynamic-pricing-calendar",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @hpc/playground dev",
		"dev:demo": "pnpm --filter @hpc/headless-demo dev",
		"build": "pnpm --filter \"./apps/*\" build",
		"start": "pnpm --filter @hpc/playground start",
		"start:demo": "pnpm --filter @hpc/headless-demo start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/playground/tsconfig.json && tsc --noEmit -p apps/headless-demo/tsconfig.json",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"author": "Christian Torrealba",
	"packageManager": "pnpm@12.9.1",
	"license": "MIT",
	"description": "Headless pricing calendar SDK and TanStack Start reference playground.",
	"engines": {
		"node": ">=26.0.0 <27.0.0",
		"pnpm": ">=12.9.1 <13.0.0"
	},
	"dependencies": {
		"@hpc/contracts": "workspace:*",
		"@mantine/core": "^9.8.2",
		"@mantine/hooks": "^9.8.2",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-query-devtools": "^5.108.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^31.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
