{
	"name": "dynamic-pricing-calendar",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @hpc/demo dev",
		"dev:test-backend": "node apps/demo/test-backend.mjs",
		"build": "pnpm --filter \"./apps/*\" build",
		"start": "pnpm --filter @hpc/demo start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/demo/tsconfig.json",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"author": "Christian Torrealba",
	"packageManager": "pnpm@12.9.1",
	"license": "MIT",
	"description": "Contract-first pricing calendar reference app with interactive API docs and a Vite demo.",
	"engines": {
		"node": ">=26.0.0 <27.0.0",
		"pnpm": ">=12.9.1 <13.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/node": "^26.6.6",
		"orval": "8.48.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
