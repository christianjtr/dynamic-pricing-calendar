{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"paths": {
			"@shared/types": ["../shared/types"],
			"@shared/types/*": ["../shared/types/*"]
		},
		"noEmit": true
	},
	"include": ["./*.ts", "../shared/**/*.ts"]
}
